{
  "name": "dsh-hello",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal DeepSeek Harness (DSH) bundle plugin: logs once when the profile loads it.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
